{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BFFをデバッグ",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@rekognition-manager/bff"],
      "cwd": "${workspaceFolder}",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Webをデバッグ",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@rekognition-manager/web"],
      "cwd": "${workspaceFolder}",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Web + BFFをデバッグ",
      "configurations": ["Webをデバッグ", "BFFをデバッグ"],
      "stopAll": true
    }
  ]
}
