# BFF
PORT=3001
LOG_LEVEL=info

AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# WebからBFFへのサーバー側プロキシ先
BFF_ORIGIN=http://localhost:3001

# OIDC認証 (デフォルトは無効)
OIDC_ENABLED=false
# OIDC_ISSUER_URL=https://id.example.com
# OIDC_CLIENT_ID=rekognition-manager
# OIDC_CLIENT_SECRET=
# セッションCookie署名用の32文字以上のランダムな値
# OIDC_AUTH_SECRET=
# ログイン画面へ表示するプロバイダー名
# OIDC_PROVIDER_NAME=Pocket ID
# プロバイダーがaudienceを要求する場合だけ設定
# OIDC_AUDIENCE=
# プロバイダー側のSSOセッションも終了する場合だけ設定
# OIDC_END_SESSION_URL=https://id.example.com/end-session
# OIDCプロバイダーへ登録するURL: http://localhost:3000/auth/callback
# APP_ORIGIN=http://localhost:3000

# 顔画像を保存するS3バケット名
FACE_IMAGE_BUCKET_NAME=
