  "license": "ISC",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "openapi:generate": "node --import tsx scripts/generate-openapi.ts",
    "openapi:check": "node --import tsx scripts/generate-openapi.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "3.1088.0",
    "@aws-sdk/client-s3": "^3.1088.0",
    "@hono/node-server": "2.0.9",
    "@hono/oidc-auth": "1.8.2",
    "@hono/standard-validator": "0.2.2",
    "@rekognition-manager/contracts": "*",
    "dotenv": "17.2.1",
    "hono": "4.12.30",
    "hono-openapi": "1.3.0",
    "pino": "9.7.0",
    "zod": "4.0.10"
  },
  "devDependencies": {
    "pino-pretty": "13.1.1",
    "tsx": "4.20.3",
    "vitest": "4.1.10"
  }
}
