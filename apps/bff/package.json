    "@hono/standard-validator": "^0.4.1",
    "@rekognition-manager/contracts": "*",
    "dotenv": "^18.0.9",
    "hono": "^4.13.14",
    "hono-openapi": "^1.5.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15"
  }
}
